# MirageSSH Environment Configuration
# Copy this file to .env and populate your credentials

# ==========================================
# AI Provider Configuration
# ==========================================
# Google Gemini API Key (Recommended - fast & generous free tier)
GEMINI_API_KEY=

# OpenAI / Ollama API Key (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# Alert Dispatchers (Optional)
# ==========================================
# Discord Webhook URL for intrusion notifications
DISCORD_WEBHOOK_URL=

# Telegram Bot Alert Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic HTTP Webhook Endpoint
GENERIC_WEBHOOK_URL=

# ==========================================
# Dashboard Security
# ==========================================
DASHBOARD_PASSWORD=AdminP@ssw0rd99!
